#!/bin/sh
# One-time setup on the first boot of a freshly written image.
set -eu

# Grow the root partition and filesystem to the whole disk.
root_dev=$(findmnt -n -o SOURCE /)
disk=/dev/$(lsblk -n -o PKNAME "$root_dev")
part=$(cat "/sys/class/block/$(basename "$root_dev")/partition")
growpart "$disk" "$part" || true
resize2fs "$root_dev"

# Unique SSH host keys for every device (machine-id is generated by systemd).
rm -f /etc/ssh/ssh_host_*
ssh-keygen -A

mkdir -p /var/lib/suplaos
touch /var/lib/suplaos/firstboot-done
