[Unit]
Description=SuplaOS first boot setup
ConditionPathExists=!/var/lib/suplaos/firstboot-done
# Only on a SuplaOS image (the file comes from the image build).
ConditionPathExists=/etc/suplaos-release
Before=ssh.service docker.service

[Service]
Type=oneshot
ExecStart=/usr/lib/suplaos/firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
