#!/bin/bash
# Update the system: Debian packages, the Raspberry Pi kernel and SuplaOS.
# Run as its own systemd unit (suplaos upgrade, the panel), so that a
# restart of the panel during the update does not stop it. The panel reads
# the log and the state file.
set -uo pipefail

state=/var/lib/suplaos/upgrade-state
log=/var/log/suplaos/upgrade.log
mkdir -p "$(dirname "$state")" "$(dirname "$log")"

echo "running $(date +%s)" > "$state"
: > "$log"
exec > >(tee -a "$log") 2>&1

export DEBIAN_FRONTEND=noninteractive
# Wait for apt used by something else (e.g. the daily unattended-upgrades).
lock_opts=(-o DPkg::Lock::Timeout=600)
apt_opts=(-y "${lock_opts[@]}" -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

# apt-get update does not wait for the lock of the package lists itself.
# Messages in English, to recognize that error.
export LC_ALL=C.UTF-8
rc=0
for try in $(seq 60); do
  rc=0
  out=$(apt-get "${lock_opts[@]}" update 2>&1) || rc=$?
  echo "$out"
  [ $rc -ne 0 ] && grep -q "Could not get lock" <<< "$out" || break
  echo "Waiting for another apt to finish..."
  sleep 10
done
if [ $rc -eq 0 ]; then
  apt-get "${apt_opts[@]}" full-upgrade || rc=$?
fi
if [ $rc -eq 0 ]; then
  apt-get "${apt_opts[@]}" autoremove --purge || true
fi

# A newer kernel of the running flavour (e.g. rpi-v8, amd64) needs a restart;
# /run is emptied by it.
running=$(uname -r)
flavour=${running#*-}
newest=$(ls /boot/vmlinuz-*-"$flavour" 2>/dev/null | sed 's|^/boot/vmlinuz-||' | sort -V | tail -n 1)
if [ -n "$newest" ] && [ "$newest" != "$running" ]; then
  mkdir -p /run/suplaos
  touch /run/suplaos/reboot-required
  echo "Kernel $newest installed, restart the device to use it."
fi

if [ $rc -eq 0 ]; then
  echo "Update finished."
  echo "done $(date +%s)" > "$state"
else
  echo "Update failed (exit code $rc)."
  echo "failed $(date +%s)" > "$state"
fi
exit $rc
