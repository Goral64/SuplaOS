#!/bin/sh
set -e

if [ "$1" = configure ]; then
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable suplaos-panel.service suplaos-firstboot.service >/dev/null 2>&1 || true
  # On a running system (not while the image is built) use the new panel.
  if [ -d /run/systemd/system ]; then
    systemctl try-restart suplaos-panel.service || true
  fi
fi
