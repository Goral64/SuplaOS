# Minimal stand-in for supla-docker's .env.default.
SUPLA_HOST_ADDRESS=cloud.supla.org
MAILER_DSN=null://null
VOLUME_DATA=./var
PORT_HTTP=80
PORT_HTTPS=443
DATABASE_PASSWORD=CHANGE_PASSWORD_BEFORE_FIRST_LAUNCH
APP_SECRET=CHANGE_SECRET_BEFORE_FIRST_LAUNCH
DATABASE_IMAGE=mariadb:12.2.2
COMPOSE_PROJECT_NAME=supla
COMPOSE_FILE=docker-compose.yml:docker-compose.standalone.yml
